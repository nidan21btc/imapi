            }
          },
          "to": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Address"
            }
          },
          "cc": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Address"
            }
          },
          "subject": {
            "type": "string"
          },
          "seen": {
            "type": "boolean"
          },
          "flagged": {
            "type": "boolean"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "description": "Reported raw MIME size in bytes."
          },
          "attachment_count": {
            "type": "integer",
            "minimum": 0,
            "nullable": true,
            "description": "Number including inline attachments, or null if the MIME body was not loaded; null is not zero."
          }
        },
        "required": [
          "uid",
          "date",
          "from",
          "to",
          "cc",
          "subject",
          "seen",
          "flagged",
          "size",
          "attachment_count"
        ]
      },
