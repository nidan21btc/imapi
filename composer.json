{
    "name": "sann/imapi",
    "description": "Small HTTPS IMAP/SMTP API without stored mailbox credentials",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Carsten Sann",
            "email": "carsten@sann.cc"
        }
    ],
    "require": {
        "phpmailer/phpmailer": "^7.2",
        "webklex/php-imap": "^6.2",
        "php": ">=8.2",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-iconv": "*",
        "ext-dom": "*",
        "ext-fileinfo": "*"
    },
    "scripts": {
        "analyse": "phpstan analyse --no-progress --memory-limit=512M",
        "test": ["@php tests/run.php", "@php tests/auth.php", "@php tests/imap.php", "@php tests/smtp.php"],
        "check": ["@composer validate --strict", "@analyse", "@test"]
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3"
    }
}
